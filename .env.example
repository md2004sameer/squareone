# Neon is the application database for authentication and user data.
# H2 is reserved for isolated checks with the h2-test profile; never use it for real accounts.
# Copy to .env. Keep the real credentials out of source control.
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_HOST/neondb?sslmode=require&channelBinding=require&currentSchema=squareone
SPRING_DATASOURCE_USERNAME=YOUR_DATABASE_USER
SPRING_DATASOURCE_PASSWORD=YOUR_DATABASE_PASSWORD
DATABASE_SCHEMA=squareone
SPRING_SQL_INIT_MODE=never
# Only enable production mode on the HTTPS host, not on HTTP localhost.
# SPRING_PROFILES_ACTIVE=production
# For an existing pre-Flyway schema ONLY, after backup/rehearsal, enable for
# the first upgraded startup and remove it once migrations succeed:
# FLYWAY_BASELINE_ON_MIGRATE=true
